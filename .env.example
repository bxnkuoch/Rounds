# Template for local.env. Copy to local.env and fill in. This file IS committed: no real values.
# Backend loads this file (server-side only).

# --- Matterport Model API (GraphQL) ---
# Endpoint: https://api.matterport.com/api/models/graph
# Auth: HTTP Basic, username = Token ID, password = Token Secret. Server-side only.
# Docs: https://developers.matterport.com/api/
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
MATTERPORT_GRAPHQL_URL=https://api.matterport.com/api/models/graph

# --- Matterport Showcase / Embed SDK ---
# SDK key ("applicationKey"). The domain allowlist currently covers localhost only (http + https).
# Docs: https://developers.matterport.com/overview/
MATTERPORT_SDK_KEY=
# Model (space) ID to load, e.g. the `m=` value in https://my.matterport.com/show?m=XXXX
MATTERPORT_MODEL_ID=

# --- CoStar hackathon kit (local only; sponsor data, never commit) ---
COSTAR_DATA_DIR=/path/to/costar-hackathon-kit

# --- Rounds agent (Anthropic API) ---
# Required to run the agent. Without it, /agent/* returns error(model_unavailable) and the rest of the app keeps working.
ANTHROPIC_API_KEY=
# Optional. Default: anthropic:claude-haiku-5-5
AGENT_MODEL=anthropic:claude-haiku-5-5
